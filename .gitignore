# Test output
coverage/

# Runtime logs
*.log

# macOS metadata
.DS_Store
._*

# Vim/Neovim temporary files
*.swp
*.swo
*.swn
*~

# Local environment overrides; keep templates versioned
.env
.env.*
!.env.example
!.env.sample
!.env.template
